{
  "name": "pigroups-adapter-pi",
  "version": "0.18.2",
  "private": false,
  "type": "module",
  "description": "A Pi extension that turns a pi session into a member of a PiGroups workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YhVgYe98/pigroups-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "pigroups"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/设计说明.md",
    "docs/概念稿.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:catalog": "node test/catalog.ts",
    "test:catalog:check": "node test/catalog.ts --check",
    "test:package": "node --test test/package.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:catalog:check && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "pigroups": "0.7.2"
  }
}
