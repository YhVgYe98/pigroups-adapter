{
  "name": "pigroups-adapter-pi",
  "version": "0.6.0+platform.0.2.0",
  "private": true,
  "type": "module",
  "description": "A Pi extension that turns a pi session into a member of a PiGroups workspace.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/YhVgYe98/pigroups-adapter"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "pigroups"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  }
}
